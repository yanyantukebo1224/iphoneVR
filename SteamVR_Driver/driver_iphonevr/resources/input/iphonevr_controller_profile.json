{
  "jsonid": "input_profile",
  "controller_type": "knuckles",
  "device_class": "TrackedDeviceClass_Controller",
  "resource_root": "iphonevr",
  "driver_name": "iphonevr",
  "legacy_binding": "{iphonevr}/input/legacy_bindings_iphonevr.json",
  "input_bindingui_mode": "controller_handed",
  "should_show_binding_errors": false,
  "input_source": {
    "/input/skeleton/left": {
      "type": "skeleton",
      "skeleton": "/skeleton/hand/left",
      "side": "left"
    },
    "/input/skeleton/right": {
      "type": "skeleton",
      "skeleton": "/skeleton/hand/right",
      "side": "right"
    },
    "/input/system": {
      "type": "button",
      "click": true,
      "touch": false,
      "order": 1
    },
    "/input/a": {
      "type": "button",
      "click": true,
      "touch": false,
      "order": 2
    },
    "/input/b": {
      "type": "button",
      "click": true,
      "touch": false,
      "order": 3
    },
    "/input/x": {
      "type": "button",
      "click": true,
      "touch": false,
      "order": 4
    },
    "/input/y": {
      "type": "button",
      "click": true,
      "touch": false,
      "order": 5
    },
    "/input/trigger": {
      "type": "trigger",
      "click": true,
      "value": true,
      "touch": false,
      "order": 6
    },
    "/input/grip": {
      "type": "trigger",
      "click": true,
      "value": true,
      "touch": false,
      "order": 7
    },
    "/input/thumbstick": {
      "type": "joystick",
      "click": true,
      "touch": false,
      "order": 8
    }
  }
}